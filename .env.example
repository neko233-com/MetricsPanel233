# Workspace Bearer token. Always required for non-loopback listeners and for
# CLI automation, even when browser accounts are enabled.
METRICSPANEL_TOKEN=replace-with-a-random-workspace-token

# Authentication mode: token (default) or local (users, passwords, sessions).
METRICSPANEL_AUTH=token

# Optional first administrator for local mode. The password must contain at
# least 12 characters. Remove these lines after the first start.
METRICSPANEL_ADMIN_USER=
METRICSPANEL_ADMIN_PASSWORD=
METRICSPANEL_ADMIN_EMAIL=

# Identity catalog path; defaults to identity.db beside the control database.
# METRICSPANEL_IDENTITY_DB=/data/identity.db

CLICKHOUSE_PASSWORD=replace-with-a-random-database-password
